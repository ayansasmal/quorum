{
  "name": "quorum",
  "version": "0.2.0",
  "description": "Quorum monorepo — governed engineering memory for Claude Code and AI agents",
  "type": "module",
  "private": true,
  "workspaces": ["mcp", "gateway", "dashboard"],
  "scripts": {
    "docker:start": "./scripts/setup.sh docker",
    "docker:rebuild": "./scripts/setup.sh docker rebuild",
    "docker:clean": "./scripts/setup.sh docker clean",
    "docker:clean:all": "./scripts/setup.sh docker clean --volumes",
    "docker:ps": "./scripts/setup.sh docker ps",
    "build": "npm run build:all --workspace=mcp",
    "dev:mcp": "npm run dev --workspace=mcp",
    "dev:gateway": "npm run dev --workspace=gateway",
    "start:mcp": "npm run start --workspace=mcp",
    "start:gateway": "npm run start --workspace=gateway",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:constitutional": "vitest run tests/constitutional",
    "test:governance": "vitest run tests/governance",
    "test:tools": "vitest run tests/tools",
    "test:coverage": "vitest run --coverage",
    "seed": "node scripts/seed.js",
    "audit:scan-bypasses": "node scripts/audit-scan.js",
    "audit:scan-harddeletes": "node scripts/audit-scan-harddeletes.js",
    "job:decay": "node scripts/decay-confidence.js",
    "job:archive": "node scripts/archive-audit.js",
    "job:recheck": "node scripts/recheck-conflicts.js",
    "mcp:install": "npm run build --workspace=mcp && claude mcp add quorum -- node \"$PWD/mcp/dist/server.js\"",
    "skill:install": "rm -rf \"$HOME/.claude/skills/quorum\" && mkdir -p \"$HOME/.claude/skills/quorum\" && cp -r \"$PWD/mcp/skill/.\" \"$HOME/.claude/skills/quorum/\" && echo \"Quorum skill installed → $HOME/.claude/skills/quorum/\"",
    "quorum:install": "npm run mcp:install && npm run skill:install"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.2",
    "vitest": "4.1.2"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.2",
    "hono": "^4.12.15"
  }
}
