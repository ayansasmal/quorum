{
  "name": "quorum",
  "version": "0.2.0",
  "description": "Quorum monorepo — governed engineering memory for Claude Code and AI agents",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "workspaces": [
    "gateway",
    "dashboard"
  ],
  "scripts": {
    "version": "node scripts/sync-versions.js && git add gateway/package.json dashboard/package.json",
    "version:sync": "node scripts/sync-versions.js",
    "release": "commit-and-tag-version",
    "release:dry": "commit-and-tag-version --dry-run",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:patch": "commit-and-tag-version --release-as patch",
    "docker:start": "./scripts/setup.sh docker",
    "docker:rebuild": "./scripts/setup.sh docker rebuild",
    "docker:clean": "./scripts/setup.sh docker clean",
    "docker:clean:all": "./scripts/setup.sh docker clean --volumes",
    "docker:ps": "./scripts/setup.sh docker ps",
    "dev:gateway": "npm run dev --workspace=gateway",
    "start:gateway": "npm run start --workspace=gateway",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gateway": "vitest run tests/gateway",
    "test:coverage": "vitest run --coverage",
    "seed": "node scripts/seed.js",
    "audit:scan-bypasses": "node scripts/audit-scan.js",
    "audit:scan-harddeletes": "node scripts/audit-scan-harddeletes.js",
    "audit:cli": "node scripts/audit-cli.js",
    "job:decay": "node scripts/decay-confidence.js",
    "job:archive": "node scripts/archive-audit.js",
    "job:recheck": "node scripts/recheck-conflicts.js",
    "prepare": "husky || true",
    "test:e2e": "mkdir -p logs && bash -c 'set -o pipefail; ts=$(date +%Y%m%d-%H%M%S); playwright test 2>&1 | tee \"logs/test-e2e-$ts.log\"; code=$?; echo \"\"; echo \"📋  Log saved → logs/test-e2e-$ts.log\"; echo \"🌐  Graph report → test-results/suite-graph.html\"; exit $code'",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:graph": "open test-results/suite-graph.html",
    "test:e2e:log": "tail -n 100 $(ls -t logs/test-e2e-*.log 2>/dev/null | head -1)",
    "test:e2e:env:up": "docker compose -f docker-compose.yml -f docker-compose.test.yml up -d --build",
    "test:e2e:env:init": "QUORUM_CONFIG_BUCKET=quorum-configs-test QUORUM_DDB_USER_PROJECTS_TABLE=quorum-user-projects-test QUORUM_FIRST_ADMIN=test-admin ./scripts/init-localstack.sh",
    "test:e2e:env:setup": "npm run test:e2e:env:up && npm run test:e2e:env:init",
    "test:e2e:env:down": "docker compose -f docker-compose.yml -f docker-compose.test.yml down",
    "test:e2e:env:clean": "docker compose -f docker-compose.yml -f docker-compose.test.yml down --volumes",
    "test:e2e:full": "npm run test:e2e:env:setup && npm run test:e2e",
    "test:e2e:docker": "sh scripts/e2e-docker.sh full",
    "test:e2e:docker:up": "sh scripts/e2e-docker.sh up",
    "test:e2e:docker:run": "sh scripts/e2e-docker.sh run",
    "test:e2e:docker:down": "sh scripts/e2e-docker.sh down",
    "test:e2e:docker:clean": "sh scripts/e2e-docker.sh clean",
    "test:e2e:docker:logs": "docker compose -f docker-compose.e2e.yml logs -f test-runner"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@playwright/test": "^1.50.0",
    "@vitest/coverage-v8": "4.1.2",
    "axios": "^1.7.9",
    "commit-and-tag-version": "^12.7.3",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.2",
    "vitest": "4.1.2"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.2",
    "hono": "^4.12.15"
  }
}
