{
  "name": "quorum",
  "version": "0.2.0",
  "description": "Governance layer for AI agent engineering memory — built on Graphiti's temporal knowledge graph",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "quorum": "./cli.js"
  },
  "exports": {
    "./server": "./src/server.js",
    "./cli": "./cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:gateway": "node src/gateway/server.js",
    "dev:gateway": "node --watch src/gateway/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:constitutional": "vitest run tests/constitutional",
    "test:governance": "vitest run tests/governance",
    "test:tools": "vitest run tests/tools",
    "test:coverage": "vitest run --coverage",
    "test:coverage:constitutional": "vitest run --coverage --coverage.include='src/governance/constitutional.js' tests/constitutional",
    "seed": "node scripts/seed.js",
    "audit:scan-bypasses": "node scripts/audit-scan.js",
    "audit:scan-harddeletes": "node scripts/audit-scan-harddeletes.js",
    "job:decay": "node scripts/decay-confidence.js",
    "job:archive": "node scripts/archive-audit.js",
    "job:recheck": "node scripts/recheck-conflicts.js",
    "mcp:install": "claude mcp add quorum -- node \"$PWD/src/server.js\"",
    "skill:install": "mkdir -p \"${INIT_CWD:-.}/.claude/skills\" && cp \"$PWD/skill/SKILL.md\" \"${INIT_CWD:-.}/.claude/skills/quorum.md\" && echo \"Quorum skill installed → ${INIT_CWD:-.}/.claude/skills/quorum.md\"",
    "quorum:install": "npm run mcp:install && npm run skill:install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1032.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "14.0.3",
    "express": "^5.2.1",
    "jose": "5.10.0",
    "pg": "8.20.0",
    "uuid": "^14.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.2",
    "vitest": "4.1.2"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.2",
    "hono": "^4.12.15"
  }
}
