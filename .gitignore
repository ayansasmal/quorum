node_modules/
.env
dist/
coverage/
*.log
.DS_Store
.DS_STORE

# Logs — keep folder structure, ignore log files
logs/
!logs/.gitkeep

# Editor tooling — local workspace settings (never commit)
.vscode/
.idea/

# AI tooling — local state and worktree artifacts (never commit)
.claude/
.claire/

# Local project configs — contain real github_usernames and git emails.
# Copy example.quorum.json to configs/<group_id>.quorum.json to get started.
# These are uploaded to LocalStack S3 by init-localstack.sh and never go in git.
configs/*.quorum.json

# Crossplane real credentials (never commit)
crossplane/credentials/aws-creds-secret.yaml

# Infrastructure tooling state — never go in git
.terraform/

# Quorum session state (project-local, per-engineer)
.quorum-session
.quorum-reflected
.quorum-offline.log
