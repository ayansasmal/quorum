{
  "name": "@as-quorum/mcp",
  "version": "0.2.0",
  "description": "Quorum MCP server — governed engineering memory for Claude Code and AI agents",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=20.0.0" },
  "bin": {
    "quorum-mcp": "./dist/server.js",
    "quorum": "./dist/cli.js"
  },
  "exports": {
    "./config/schema": "./src/config/schema.js",
    "./graph/queries": "./src/graph/queries.js",
    "./graph/client": "./src/graph/client.js",
    "./audit/secondary": "./src/audit/secondary.js",
    "./governance/constitutional": "./src/governance/constitutional.js",
    ".": "./dist/server.js"
  },
  "files": [
    "dist/",
    "cli.js",
    "skill/"
  ],
  "scripts": {
    "build": "esbuild src/server.js --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "build:cli": "esbuild cli.js --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "build:all": "npm run build && npm run build:cli",
    "dev": "node --watch src/server.js",
    "start": "node dist/server.js",
    "prepublishOnly": "npm run build:all"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "14.0.3",
    "pg": "8.20.0",
    "uuid": "^14.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
