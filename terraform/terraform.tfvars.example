# Copy to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars to version control.

aws_region  = "ap-southeast-2"
environment = "production"

# Globally unique S3 bucket name
bucket_name = "acme-quorum-configs"

# Project IDs that will have prefix paths in the bucket.
# Each creates a separate IAM policy for that project's team lead.
project_ids = [
  "platform-team",
  "backend-team",
  "security-team",
]

# IAM ARNs for team leads who can write project configs.
# These are the actual authority boundary for Quorum's governance model.
# An engineer cannot elevate their own role by editing config — IAM prevents writes.
team_lead_arns = [
  "arn:aws:iam::123456789012:user/alice",
  "arn:aws:iam::123456789012:assumed-role/TeamLeadsRole/session",
]

# EKS OIDC provider details (from your EKS cluster Terraform outputs).
# Required for IRSA — the gateway pod uses this to assume the gateway IAM role.
eks_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/oidc.eks.ap-southeast-2.amazonaws.com/id/EXAMPLED539D4633E53DE1B71EXAMPLE"
eks_oidc_provider_url = "oidc.eks.ap-southeast-2.amazonaws.com/id/EXAMPLED539D4633E53DE1B71EXAMPLE"

# Kubernetes namespace and service account where the gateway runs
gateway_eks_namespace        = "quorum"
gateway_service_account_name = "quorum-gateway"
